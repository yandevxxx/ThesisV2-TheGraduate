#--------------------------------------------------------------------
# LDAP (AUTENTIKASI KAMPUS)
#--------------------------------------------------------------------
# Mahasiswa dan dosen memakai akun kampus (LDAP). Akun dengan password
# lokal (umumnya admin, kaprodi, fakultas, tamu, dan sebagian tendik) tidak
# memakai LDAP. Akun dengan kolom password NULL otomatis memakai LDAP.
#
# Nilai di bawah adalah default pengembangan. Sesuaikan dengan server
# LDAP kampus dan simpan kredensial service account di .env, bukan di Git.

# authldap.ldapDomain = pdc.yarsi.ac.id
# authldap.baseDn = 'dc=yarsi,dc=ac,dc=id'
# authldap.groupsDn = 'ou=Groups,dc=yarsi,dc=ac,dc=id'
# authldap.useTls = false
# authldap.useStartTls = false
# authldap.bindDn = ''
# authldap.bindPassword = ''
# authldap.ldapUserAttribute = 'uid'
# authldap.ldapGroupAttribute = 'cn'
# authldap.roleAttribute = 'title'
# authldap.networkTimeout = 5
# authldap.searchSizeLimit = 2

# Port LDAP diatur di app/Config/AuthLdap.php ($tcpPort):
#   389 untuk LDAP biasa / StartTLS, 636 untuk LDAPS.
#
# B-03: profil lokal diprovision otomatis bila data lokal cukup. Perubahan
# profil masuk ke tabel ldap_profile_sync dan diproses oleh:
#   php spark auth:sync-ldap-profiles --limit=100

