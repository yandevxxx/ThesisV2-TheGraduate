#--------------------------------------------------------------------
# Example Environment Configuration (Template Tanpa Nilai Rahasia)
#--------------------------------------------------------------------
# Salin file ini menjadi .env di mesin lokal atau server:
#   copy .env.example .env    (Windows)
#   cp .env.example .env      (Linux/macOS)
# Jangan pernah meng-commit file .env atau mengisi nilai rahasia di file ini.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = true

app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionCookieName = 'ci_session'
app.sessionExpiration = 28800
app.sessionSavePath = null
app.sessionMatchIP = false
app.sessionTimeToUpdate = 300
app.sessionRegenerateDestroy = true

#--------------------------------------------------------------------
# DATABASE (isi kredensial hanya di .env lokal/server)
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database =
database.default.username =
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

database.tests.hostname = localhost
database.tests.database =
database.tests.username =
database.tests.password =
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =

#--------------------------------------------------------------------
# LDAP AUTENTIKASI KAMPUS (isi kredensial bind hanya di .env)
#--------------------------------------------------------------------

authldap.ldapDomain = pdc.yarsi.ac.id
authldap.baseDn = 'dc=yarsi,dc=ac,dc=id'
authldap.groupsDn = 'ou=Groups,dc=yarsi,dc=ac,dc=id'
authldap.useTls = false
authldap.useStartTls = false
authldap.bindDn = ''
authldap.bindPassword = ''
authldap.ldapUserAttribute = 'uid'
authldap.ldapGroupAttribute = 'cn'
authldap.roleAttribute = 'title'
authldap.networkTimeout = 5
authldap.searchSizeLimit = 2

#--------------------------------------------------------------------
# KEAMANAN AUTENTIKASI & SESI
#--------------------------------------------------------------------

authsecurity.loginMaxAttempts = 5
authsecurity.loginDecaySeconds = 120
authsecurity.ipMaxAttempts = 20
authsecurity.ipDecaySeconds = 120
authsecurity.sessionIdleTimeout = 1800
authsecurity.sessionAbsoluteTimeout = 28800

#--------------------------------------------------------------------
# COOKIE & KEAMANAN HEADER / CORS
#--------------------------------------------------------------------

cookie.prefix = ''
cookie.expires = 0
cookie.path = '/'
cookie.domain = ''
cookie.secure = false
cookie.httponly = true
cookie.samesite = 'Lax'
cookie.raw = false

security.csrfProtection = 'cookie'
security.tokenRandomize = false
security.tokenName = 'csrf_test_name'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_name'
security.expires = 7200
security.regenerate = true
security.redirect = true
security.samesite = 'Lax'
# Kosongkan agar hanya same-origin (baseURL) yang diizinkan; isi daftar terpisah koma bila ada frontend terpisah
security.corsAllowedOrigins = ''

#--------------------------------------------------------------------
# ENCRYPTION KEY (isi hex2bin:<64 hex> hanya di .env, jangan di Git)
#--------------------------------------------------------------------

encryption.key =
encryption.driver = OpenSSL
encryption.blockSize = 16
encryption.digest = SHA512

#--------------------------------------------------------------------
# EMAIL SMTP (isi username & password aplikasi hanya di .env)
#--------------------------------------------------------------------

email.fromEmail = ''
email.fromName = 'TheSIS Graduate'
email.SMTPHost = 'smtp.gmail.com'
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = 587
email.SMTPCrypto = 'tls'

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 6
